- name: sync
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nNB-IoT front end -- Embedded Python Block (GNU Radio 3.10)\n\
      \nInput : complex @ 1.92 MS/s, NB-IoT anchor carrier centred at 0 Hz\n     \
      \   (output of the stock Frequency Xlating FFT Filter).\nOutput: complex vectors\
      \ of 128 = one OFDM symbol with its cyclic prefix removed and the\n        carrier-frequency\
      \ offset corrected; 140 vectors per 10 ms radio frame. The first\n        vector\
      \ of every frame carries the tag 'frame' (value = frame counter).\n\nWhy an\
      \ EPB: NPSS acquisition over a +-7 kHz CFO search, per-frame NPSS tracking of\
      \ timing\nand frequency (RTL clock drift), and stripping the alternating 10/9-sample\
      \ cyclic prefix on\na frame grid have no stock equivalents (Keep M in N needs\
      \ a constant period, and no stock\nblock re-times on a correlation peak). The\
      \ FFT and sub-carrier selection that follow are\nstock blocks. All maths lives\
      \ in the Python Module `nbiot` (passed in as `lib`).\n\"\"\"\nimport numpy as\
      \ np\nimport pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self, lib=None, verbose=True):\n        gr.basic_block.__init__(self,\
      \ name='NB-IoT Sync (NPSS, CFO, CP removal)',\n                            \
      \    in_sig=[np.complex64], out_sig=[(np.complex64, 128)])\n        self.lib\
      \ = lib\n        self.verbose = verbose\n        self.set_tag_propagation_policy(gr.TPP_DONT)\n\
      \        self.sync = lib.Sync(log=self._log) if lib is not None else None\n\
      \        self.pending = []          # [(frame (140, 128), info)]\n        self.pos\
      \ = 0               # vectors of pending[0] already written\n\n    def _log(self,\
      \ s):\n        if self.verbose:\n            print(s, flush=True)\n\n    def\
      \ forecast(self, noutput_items, ninputs):\n        return [1] * ninputs\n\n\
      \    def general_work(self, input_items, output_items):\n        inp = input_items[0]\n\
      \        out = output_items[0]\n        if self.sync is None:\n            self.consume(0,\
      \ len(inp))\n            return 0\n        backlog = sum(len(f) for f, _ in\
      \ self.pending) - self.pos\n        if backlog < 280:                      \
      \ # take input only while the backlog is small\n            self.pending +=\
      \ self.sync.feed(inp.copy())\n            self.consume(0, len(inp))\n      \
      \      lag = len(self.sync.buf) / 1.92e6\n            if lag > 1.0 and self.nitems_read(0)\
      \ > getattr(self, '_warn_at', 0):\n                self._warn_at = self.nitems_read(0)\
      \ + int(10 * 1.92e6)\n                self._log('[sync] WARNING: %.1f s of samples\
      \ queued - CPU is not keeping up' % lag)\n        n = 0\n        while self.pending\
      \ and n < len(out):\n            fr, info = self.pending[0]\n            if\
      \ self.pos == 0:\n                self.add_item_tag(0, self.nitems_written(0)\
      \ + n, pmt.intern('frame'),\n                                  pmt.from_long(int(info['seq'])))\n\
      \            k = min(len(fr) - self.pos, len(out) - n)\n            out[n:n\
      \ + k] = fr[self.pos:self.pos + k]\n            n += k\n            self.pos\
      \ += k\n            if self.pos == len(fr):\n                self.pending.pop(0)\n\
      \                self.pos = 0\n        return n\n"
    affinity: ''
    alias: ''
    comment: 'EPB #1: NPSS acquisition (+-7 kHz), timing/CFO tracking,

      CP removal -> 140 x 128 per frame, tag "frame"'
    lib: nbiot
    maxoutbuf: '0'
    minoutbuf: '2048'
    verbose: 'True'
  states:
    _io_cache: ('NB-IoT Sync (NPSS, CFO, CP removal)', 'blk', [('lib', 'None'), ('verbose',
      'True')], [('0', 'complex', 1)], [('0', 'complex', 128)], '', ['lib', 'verbose'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [820, 400]
    rotation: 0
    state: enabled
