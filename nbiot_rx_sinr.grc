- name: dec
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nNB-IoT broadcast decoder with interference (SINR) analysis\
      \ -- Embedded Python Block (GNU Radio 3.10)\n\nInput : complex vectors of 12\
      \ = the 12 NB-IoT sub-carriers of one OFDM symbol\n        (stock FFT -> Keep\
      \ M in N -> Stream to Vector), frames marked by the 'frame' tag.\nOutput message\
      \ ports:\n  'text'   : pmt string per decoded item (cell ID, MIB-NB, SIB1-NB,\
      \ SI messages) -> Message Debug\n  'npbch'  : PDU of equalised NPBCH symbols\
      \      -> QT GUI Constellation Sink (msg_complex)\n  'npdsch_clean' : PDU of\
      \ SIB/SI NPDSCH symbols from subframes with SINR >= split_db\n  'npdsch_dirty'\
      \ : the same from subframes with SINR <  split_db (co-channel bursts)\n  'sinr'\
      \   : PDU f32vector of 10 values per frame = per-subframe SINR (dB) -> QT Time\
      \ Raster (msg_float)\n             (-10 = subframe without serving-cell NRS:\
      \ NPSS, NSSS, or not yet known to carry NRS)\n\nWhy an EPB: NSSS cell-ID search\
      \ (504 x 4 hypotheses), NRS channel estimation, transmit-\ndiversity combining,\
      \ Rel-13/14 NPBCH blind frame alignment, tail-biting Viterbi with\nCRC-arbitrated\
      \ hypotheses, SIB1-NB/SI scheduling and ASN.1 decoding have no stock blocks.\n\
      All maths lives in the Python Module `nbiot` (passed in as `lib`).\n\"\"\"\n\
      import numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, lib=None, verbose=True, split_db=8.0):\n        gr.sync_block.__init__(self,\
      \ name='NB-IoT Decoder + SINR (cell ID, MIB-NB, SIBs)',\n                  \
      \             in_sig=[(np.complex64, 12)], out_sig=None)\n        for p in ('text',\
      \ 'npbch', 'npdsch_clean', 'npdsch_dirty', 'sinr'):\n            self.message_port_register_out(pmt.intern(p))\n\
      \        self.verbose = verbose\n        self.dec = lib.Decoder(log=self._log,\
      \ msg=self._msg, const=self._const, vec=self._vec,\n                       \
      \        split_db=float(split_db)) if lib is not None else None\n        self.grid\
      \ = None\n        self.n = 0\n        self.seq = 0\n\n    def _log(self, s):\n\
      \        if self.verbose:\n            print(s, flush=True)\n\n    def _msg(self,\
      \ s):\n        self.message_port_pub(pmt.intern('text'), pmt.intern(s))\n\n\
      \    def _const(self, name, z):\n        z = np.asarray(z, np.complex64)\n \
      \       z = z / (np.sqrt(np.mean(np.abs(z) ** 2)) + 1e-12)\n        self.message_port_pub(pmt.intern(name),\
      \ pmt.cons(pmt.PMT_NIL, pmt.init_c32vector(len(z), z)))\n\n    def _vec(self,\
      \ name, v):\n        v = np.asarray(v, np.float32)\n        self.message_port_pub(pmt.intern(name),\
      \ pmt.cons(pmt.PMT_NIL, pmt.init_f32vector(len(v), v)))\n\n    def work(self,\
      \ input_items, output_items):\n        inp = input_items[0]\n        if self.dec\
      \ is None:\n            return len(inp)\n        base = self.nitems_read(0)\n\
      \        starts = sorted((t.offset - base, pmt.to_long(t.value))\n         \
      \               for t in self.get_tags_in_window(0, 0, len(inp), pmt.intern('frame')))\n\
      \        bounds = [s for s, _ in starts] + [len(inp)]\n        i = 0\n     \
      \   if starts and starts[0][0] > 0:\n            self._fill(inp[:starts[0][0]])\n\
      \        for j, (s, seq) in enumerate(starts):\n            self.grid = np.zeros((140,\
      \ 12), complex)\n            self.n = 0\n            self.seq = seq\n      \
      \      self._fill(inp[s:bounds[j + 1]])\n        if not starts:\n          \
      \  self._fill(inp)\n        return len(inp)\n\n    def _fill(self, v):\n   \
      \     if self.grid is None or len(v) == 0:\n            return\n        k =\
      \ min(140 - self.n, len(v))\n        self.grid[self.n:self.n + k] = v[:k]\n\
      \        self.n += k\n        if self.n == 140:\n            try:\n        \
      \        self.dec.feed_frame(self.grid, self.seq)\n            except Exception\
      \ as e:                      # never let one bad frame stop the flowgraph\n\
      \                print('[decoder] frame %d: %s' % (self.seq, e), flush=True)\n\
      \            self.grid = None\n"
    affinity: ''
    alias: ''
    comment: 'EPB #2: NSSS cell ID, NRS channel estimation, NPBCH -> MIB-NB,

      NPDSCH -> SIB1-NB -> SI messages,

      + per-subframe SINR at the NRS (co-channel burst detector)'
    lib: nbiot
    maxoutbuf: '0'
    minoutbuf: '0'
    split_db: split_db
    verbose: 'True'
  states:
    _io_cache: ('NB-IoT Decoder + SINR (cell ID, MIB-NB, SIBs)', 'blk', [('lib', 'None'),
      ('verbose', 'True'), ('split_db', '8.0')], [('0', 'complex', 12)], [('sinr',
      'message', 1), ('npdsch_dirty', 'message', 1), ('npdsch_clean', 'message', 1),
      ('npbch', 'message', 1), ('text', 'message', 1)], '', ['verbose'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2000, 336.0]
    rotation: 0
    state: enabled
