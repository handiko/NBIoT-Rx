options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'NB-IoT downlink broadcast decoder with per-subframe SINR / co-channel
      interference analysis (standalone / guard-band anchor): NPSS sync, cell ID,
      MIB-NB, SIB1-NB and SI messages. RTL-SDR, stock blocks + 2 EPBs + Python Module.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: nbiot_rx_sinr
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: NB-IoT downlink decoder + SINR analysis
    window_size: (1700,1150)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: cfo_hz
  id: variable_qtgui_range
  parameters:
    comment: 'Normally 0: the sync block searches +-7 kHz and tracks drift by itself'
    gui_hint: 0,3,1,1
    label: Fine tune [Hz]
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-5000'
    step: '50'
    stop: '5000'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 260]
    rotation: 0
    state: enabled
- name: chan_taps
  id: variable
  parameters:
    comment: keeps the 180 kHz carrier (+-90 kHz), rejects >115 kHz
    value: firdes.low_pass(1.0, samp_rate, 100e3, 30e3, window.WIN_HAMMING)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 12]
    rotation: 0
    state: enabled
- name: f_nb
  id: variable_qtgui_entry
  parameters:
    comment: 'Centre of the 180 kHz block (Gqrx: middle of the flat top). Standalone
      carriers sit on the 100 kHz raster.'
    entry_signal: editingFinished
    gui_hint: 0,0,1,1
    label: NB-IoT carrier [Hz]
    type: real
    value: 935.4e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 260]
    rotation: 0
    state: enabled
- name: gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,2,1,1
    label: RTL gain [dB]
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.1'
    stop: '49.6'
    value: '30'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 260]
    rotation: 0
    state: enabled
- name: half_sc
  id: variable
  parameters:
    comment: 'NB-IoT sub-carriers sit at (k-5.5)*15 kHz: multiply each FFT window
      by exp(j*pi*n/128)'
    value: '[complex(x) for x in nbiot.SHIFT_VEC]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [470, 100]
    rotation: 0
    state: enabled
- name: if_offset
  id: variable
  parameters:
    comment: tune the RTL this far above the carrier to keep its DC spike away
    value: 300e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [330, 12]
    rotation: 0
    state: enabled
- name: lo_freq
  id: variable
  parameters:
    comment: ''
    value: f_nb + if_offset
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [470, 12]
    rotation: 0
    state: enabled
- name: npss_len
  id: variable
  parameters:
    comment: ''
    value: len(npss_taps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 100]
    rotation: 0
    state: enabled
- name: npss_taps
  id: variable
  parameters:
    comment: NPSS matched filter at 240 kS/s (display branch)
    value: nbiot.npss_matched_taps(samp_rate / 8)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 100]
    rotation: 0
    state: enabled
- name: ppm
  id: variable_qtgui_entry
  parameters:
    comment: same value as Gqrx
    entry_signal: editingFinished
    gui_hint: 0,1,1,1
    label: RTL ppm
    type: real
    value: '34'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 260]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: '128-pt FFT at 15 kHz spacing: CP = 10/9 samples exactly'
    value: 1.92e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: split_db
  id: variable_qtgui_range
  parameters:
    comment: applied at start-up (restart the flowgraph after changing)
    gui_hint: 4,3,1,1
    label: Clean/interfered split [dB]
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '20'
    value: '8'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 260]
    rotation: 0
    state: enabled
- name: agc
  id: analog_agc2_xx
  parameters:
    affinity: ''
    alias: ''
    attack_rate: 1e-5
    comment: 'slow (~50 ms) level control, only for fixed display scales.

